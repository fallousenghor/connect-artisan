# Copiez ce fichier en .env et renseignez vos identifiants Supabase
# (Réglages du projet Supabase > API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique

# Notifications push (Web Push) — clé PUBLIQUE uniquement (la clé privée reste
# côté serveur, dans les secrets de la Edge Function "send-push").
# Générez la paire avec : npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=votre_cle_publique_vapid
